From ab68676e7771896f49643a25811fb6da6e091bc8 Mon Sep 17 00:00:00 2001
From: VitreousCut <VitreousCut@users.noreply.github.com>
Date: Thu, 29 Oct 2026 15:33:46 +0800
Subject: [PATCH 4/4] diffusion-cli: fix the shift_logits default and size the
 sequence pool

shift_logits defaulted to true when the GGUF carried no diffusion.shift_logits
key. For a bidirectional block-diffusion model the logits at position p predict
the token at p, so reading p-1 made every masked position sample from its left
neighbour's distribution. Default to false.

n_seq_max = 2 provides the scratch sequence the block schedule needs to preview a
block against a committed prefix without mutating it.
---
 examples/diffusion/diffusion-cli.cpp | 17 ++++++++++++++++-
 1 file changed, 16 insertions(+), 1 deletion(-)

diff --git a/examples/diffusion/diffusion-cli.cpp b/examples/diffusion/diffusion-cli.cpp
index c646113..039c04c 100644
--- a/examples/diffusion/diffusion-cli.cpp
+++ b/examples/diffusion/diffusion-cli.cpp
@@ -140,6 +140,10 @@ int main(int argc, char ** argv) {
     ctx_params.no_perf              = params.no_perf;
     ctx_params.type_k               = params.cache_type_k;
     ctx_params.type_v               = params.cache_type_v;
+    // Sequence 0 holds the committed prefix; sequence 1 is a scratch slot used to
+    // re-preview one block. A scratch slot is required because the Gated-DeltaNet
+    // recurrent state cannot be partially erased, only reset wholesale.
+    ctx_params.n_seq_max            = 2;
 
     llama_context * ctx = llama_init_from_model(model, ctx_params);
     if (!ctx) {
@@ -183,7 +187,10 @@ int main(int argc, char ** argv) {
     if (llama_model_meta_val_str(model, "diffusion.shift_logits", shift_logits_str, sizeof(shift_logits_str)) >= 0) {
         diff_params.shift_logits = (strcmp(shift_logits_str, "true") == 0);
     } else {
-        diff_params.shift_logits = true;
+        // Bidirectional diffusion: the logits at position p predict the token at p. The
+        // previous fallback of `true` read the logits of position p-1, so every masked
+        // position sampled from its left neighbour's distribution.
+        diff_params.shift_logits = false;
     }
 
     //Use either eps or block length, but not both
@@ -251,6 +258,14 @@ int main(int argc, char ** argv) {
             LOG_INF("\033[2J\033[H");
         }
 
+        // Slots still holding the mask token mean the denoiser ran out of passes for a block.
+        {
+            int n_mask = 0;
+            for (auto t : output_tokens) {
+                if (t == diff_params.mask_token_id) { n_mask++; }
+            }
+            LOG_DBG("masks left unresolved: %d\n", n_mask);
+        }
         output_tokens.erase(output_tokens.begin(), output_tokens.begin() + n_input);
         std::string output_data = common_detokenize(vocab, output_tokens, false);
         LOG_INF("\n%s\n", output_data.c_str());
